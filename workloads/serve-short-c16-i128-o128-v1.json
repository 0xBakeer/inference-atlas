    "input_tokens": 128,
    "output_tokens": 128,
    "seed": 42,
    "warmup_requests": 16,
    "temperature": 0,
    "repeat": 3,
    "timeout_s": 300,
    "dataset_buckets": [
      "xs",
      "s"
    ]
  },
  "sweep": null,
  "eval": null,
  "metrics_required": [

{
  "name": "@atlas/core",
  "version": "0.1.0",
  "description": "Inference Atlas shared core: types, canonicalization, ids, plausibility, coverage, scoring, packets.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "check:registries": "node scripts/check-registries.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^1.6.1"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.2"
  }
}

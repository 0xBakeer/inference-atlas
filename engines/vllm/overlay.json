  "params": {
    "model": {
      "group": "model",
      "impact": "low"
    },
    "tensor-parallel-size": {
      "group": "parallelism",
      "impact": "high",
      "featured": true
    },
    "pipeline-parallel-size": {
      "group": "parallelism",
      "impact": "high"
    },
    "data-parallel-size": {
      "group": "parallelism",
      "impact": "medium"
    },
    "distributed-executor-backend": {
      "group": "parallelism",
      "impact": "medium"
    },
    "gpu-memory-utilization": {
      "group": "memory",
      "impact": "high",
      "notes": "This is the total budget, weights included — not headroom on top of the weights. Lowering it shrinks the KV cache, which shows up as a lower max concurrency, not as lower single-stream speed.",
      "featured": true
    },
    "swap-space": {
      "group": "memory",
      "impact": "low"
    },
    "cpu-offload-gb": {
      "group": "memory",
      "impact": "high"
    },
    "max-model-len": {
      "group": "memory",
      "impact": "high",
      "featured": true
    },
    "max-num-seqs": {
      "group": "batching",
      "impact": "high",
      "featured": true
    },
    "max-num-batched-tokens": {
      "group": "batching",
      "impact": "high"
    },
    "enable-chunked-prefill": {
      "group": "batching",
      "impact": "high",
      "featured": true
    },
    "enable-prefix-caching": {
      "group": "caching",
      "impact": "high",
      "notes": "Defaults OFF for hybrid-attention models even though it is on for everything else. Pass it explicitly and record it, or you will compare a cached run against an uncached one and call it a version regression.",
      "featured": true
    },
    "block-size": {
      "group": "caching",
      "impact": "medium"
    },
    "kv-cache-dtype": {
      "group": "caching",
      "impact": "high",
      "featured": true
    },
    "mamba-ssm-cache-dtype": {
      "group": "caching",
      "impact": "medium"
    },
    "mamba-backend": {
      "group": "caching",
      "impact": "medium"
    },
    "disable-sliding-window": {
      "group": "caching",
      "impact": "medium"
    },
    "quantization": {
      "group": "quantization",
      "impact": "high",
      "featured": true
    },
    "dtype": {
      "group": "quantization",
      "impact": "high"
    },
    "speculative-config": {
      "group": "speculative",
      "impact": "high",
      "notes": "The one flag that can beat the memory-bandwidth bound on a capacity-limited machine. Record the accepted tokens per step alongside it or the number looks impossible.",
      "featured": true
    },
    "compilation-config": {
      "group": "compilation",
      "impact": "high"
    },
    "enforce-eager": {
      "group": "compilation",
      "impact": "high",
      "notes": "Saves a few GiB and several minutes of startup at a real decode cost. Frequently on by accident in shared scripts.",
      "featured": true
    },
    "max-seq-len-to-capture": {
      "group": "compilation",

{
  "schema_version": 1,
  "engine_id": "vllm",
  "groups": [
    "parallelism",
    "memory",
    "batching",
    "caching",
    "quantization",
    "speculative",
    "compilation",
    "scheduling",
    "model",
    "multimodal",
    "lora",
    "sampling",
    "server"

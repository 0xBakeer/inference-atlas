{
  "schema_version": 1,
  "id": "vllm",
  "name": "vLLM",
  "repo": "https://github.com/vllm-project/vllm",
  "docs": "https://docs.vllm.ai/",
  "description": "Paged-attention serving engine with an OpenAI-compatible API. The reference point for GPU serving throughput.",
  "api": "openai",
  "default_port": 8000,
  "platforms": [
    "linux-cuda",
    "linux-rocm",
    "linux-cpu"
  ],
  "quant_formats": [
    "bf16",
    "fp16",
    "fp8",
    "nvfp4",
    "awq-int4",
    "gptq-int4",
    "compressed-tensors",
    "bitsandbytes",
    "int8",
    "mxfp4",
    "int4"
  ],
  "install": [
    {
      "method": "docker",
      "image": "vllm/vllm-openai:v{version}",
      "arch": [
        "x86_64",
        "aarch64"
      ],
      "notes": "aarch64 images carry an -aarch64 suffix for some releases; check the tag list before assuming."
    },
    {
      "method": "pip",
      "package": "vllm=={version}",
      "arch": [
        "x86_64",
        "aarch64"
      ],
      "notes": "Use uv. VLLM_USE_PRECOMPILED=1 avoids a source build on aarch64."
    }
  ],
  "serve": {
    "command_template": "vllm serve {model_ref} {flags}",
    "model_ref": "hf_id",
    "flag_style": "--{name} {value}",
    "bool_style": "--{name}",
    "bool_false_style": "--no-{name}",
    "env_style": null,
    "notes": "JSON-valued flags such as --speculative-config take a single-quoted JSON object."
  },
  "health": {
    "path": "/health",
    "models_path": "/v1/models",
    "ready_timeout_s": 1800
  },
  "bench_harness": "atlas-bench",
  "drop_params": [
    "model",
    "host",
    "port",
    "api-key",
    "served-model-name",
    "download-dir",
    "revision",
    "hf-token",
    "tokenizer",
    "hf-config-path",
    "config-format",
    "allowed-origins",
    "uvicorn-log-level",
    "disable-log-stats",
    "ssl-keyfile",
    "ssl-certfile",
    "root-path"
  ],
  "param_aliases": {
    "tp": "tensor-parallel-size",
    "pp": "pipeline-parallel-size",
    "dp": "data-parallel-size",
    "o": "compilation-config"
  },
  "version_source": {
    "kind": "github-releases",
    "repo": "vllm-project/vllm",
    "tag_prefix": "v",
    "version_scheme": "semver"
  },
  "versions_available": [
    "0.1.dev20073+g8e685d198",
    "0.26.1",
    "0.26.1.dev0+gf2654939e.d20260726",
    "0.27.1"
  ],
  "links": {
    "releases": "https://github.com/vllm-project/vllm/releases",
    "engine_args": "https://docs.vllm.ai/en/latest/configuration/engine_args.html"
  },
  "notes": null
}

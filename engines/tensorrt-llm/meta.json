{
  "schema_version": 1,
  "id": "tensorrt-llm",
  "name": "TensorRT-LLM",
  "repo": "https://github.com/NVIDIA/TensorRT-LLM",
  "docs": "https://nvidia.github.io/TensorRT-LLM/",
  "description": "NVIDIA's own serving stack. Usually the fastest on NVIDIA silicon and the most work to set up.",
  "api": "openai",
  "default_port": 8000,
  "platforms": [
    "linux-cuda"
  ],
  "quant_formats": [
    "bf16",
    "fp16",
    "fp8",
    "nvfp4",
    "int8",
    "awq-int4",
    "mxfp4"
  ],
  "install": [
    {
      "method": "docker",
      "image": "nvcr.io/nvidia/tensorrt-llm/release:{version}",
      "arch": [
        "x86_64",
        "aarch64"
      ]
    },
    {
      "method": "pip",
      "package": "tensorrt-llm=={version}",
      "arch": [
        "x86_64"
      ]
    }
  ],
  "serve": {
    "command_template": "trtllm-serve {model_ref} {flags}",
    "model_ref": "hf_id",
    "flag_style": "--{name} {value}",
    "bool_style": "--{name}",
    "bool_false_style": null,
    "env_style": null
  },
  "health": {
    "path": "/health",
    "models_path": "/v1/models",
    "ready_timeout_s": 3600
  },
  "bench_harness": "atlas-bench",
  "drop_params": [
    "model",
    "host",
    "port",
    "api-key",
    "served-model-name",
    "download-dir",
    "revision",
    "hf-token",
    "tokenizer",
    "log-level",
    "extra-llm-api-options"
  ],
  "param_aliases": {
    "tp": "tp-size",
    "pp": "pp-size",
    "ep": "ep-size"
  },
  "version_source": {
    "kind": "github-releases",
    "repo": "NVIDIA/TensorRT-LLM",
    "tag_prefix": "v",
    "version_scheme": "semver"
  },
  "versions_available": [
    "1.2.0"
  ],
  "links": {
    "releases": "https://github.com/NVIDIA/TensorRT-LLM/releases"
  },
  "notes": "Engine build settings (max batch size, max sequence length) are baked into the compiled engine, so they belong in args even when serving does not take them as flags."
}

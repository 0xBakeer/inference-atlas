{
  "schema_version": 1,
  "engine_id": "ollama",
  "groups": [
    "parallelism",
    "memory",
    "batching",
    "caching",
    "compilation",
    "scheduling",
    "sampling",
    "server"
  ],
  "params": {
    "num-ctx": {
      "group": "memory",
      "impact": "high",
      "notes": "Ollama defaults to a small context regardless of what the model supports; a long-context claim without this set is not a long-context measurement.",
      "featured": true
    },
    "num-batch": {
      "group": "batching",
      "impact": "high",
      "featured": true
    },
    "num-gpu": {
      "group": "memory",
      "impact": "high",
      "notes": "-1 lets Ollama choose the layer split from free VRAM, so the same nominal config can differ run to run on the same box. Pin it.",
      "featured": true
    },
    "num-thread": {
      "group": "memory",
      "impact": "medium"
    },
    "num-predict": {
      "group": "sampling",
      "impact": "medium"
    },
    "num-keep": {
      "group": "sampling",
      "impact": "low"
    },
    "temperature": {
      "group": "sampling",
      "impact": "medium"
    },
    "top-k": {
      "group": "sampling",
      "impact": "low"
    },
    "top-p": {
      "group": "sampling",
      "impact": "low"
    },
    "min-p": {
      "group": "sampling",
      "impact": "low"
    },
    "repeat-penalty": {
      "group": "sampling",
      "impact": "low"
    },
    "seed": {
      "group": "sampling",
      "impact": "medium"
    },
    "ollama-flash-attention": {
      "group": "compilation",
      "impact": "high",
      "featured": true
    },
    "ollama-kv-cache-type": {
      "group": "caching",
      "impact": "high",
      "featured": true
    },
    "ollama-num-parallel": {
      "group": "batching",
      "impact": "high",
      "featured": true
    },
    "ollama-max-loaded-models": {
      "group": "memory",
      "impact": "medium"
    },
    "ollama-max-queue": {
      "group": "scheduling",
      "impact": "medium"
    },
    "ollama-sched-spread": {
      "group": "parallelism",
      "impact": "high",
      "featured": true
    },
    "ollama-new-engine": {
      "group": "compilation",
      "impact": "high",
      "notes": "The Go engine and the llama.cpp runner are different code paths with different numbers. Record which one served the request.",
      "featured": true
    },
    "ollama-gpu-overhead": {
      "group": "memory",
      "impact": "medium"
    },
    "keep-alive": {
      "group": "server",
      "impact": "low"
    },
    "ollama-host": {
      "group": "server",
      "impact": "low"
    },
    "ollama-models": {
      "group": "server",
      "impact": "low"
    },
    "ollama-debug": {
      "group": "server",
      "impact": "low"
    }
  }
}

{
  "name": "inference-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "A community-owned map of LLM inference engine configurations.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "pnpm --filter @atlas/tools run validate",
    "build:data": "pnpm --filter @atlas/tools run build",
    "dev": "pnpm run build:data && pnpm --filter @atlas/app run dev",
    "tui": "pnpm --filter @atlas/tui run start",
    "build": "pnpm run build:data && pnpm --filter @atlas/app run build",
    "test": "vitest run --passWithNoTests",
    "packet": "pnpm --filter @atlas/tools run packet",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "check:registries": "node packages/core/scripts/check-registries.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^2.1.8"
  }
}
